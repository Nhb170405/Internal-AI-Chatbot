# Copy to .env.production on the EC2 instance. Never commit the real file.

OPENAI_API_KEY=<openai-api-key>
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Generate with: openssl rand -hex 32
PYTHON_SERVICE_API_KEY=<64-character-random-secret>

QDRANT_URL=https://<cluster>.cloud.qdrant.io:6333
QDRANT_API_KEY=<qdrant-api-key>
QDRANT_COLLECTION=internal_documents

# Cloudflare R2 S3-compatible API credentials.
R2_SERVICE_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=internal-chatbot-files
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>

# Amazon RDS for SQL Server Express. Keep the value on one line.
SQL_CONNECTION_STRING=Server=<rds-endpoint>,1433;Database=internal_ai_chatbot;User Id=<master-user>;Password=<password>;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;

# Enable only for the first production start. Disable it and remove the
# credentials after the first admin signs in successfully.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=<admin-email>
BOOTSTRAP_ADMIN_PASSWORD=<unique-password-with-at-least-12-characters>

TESSERACT_LANG=vie+eng
